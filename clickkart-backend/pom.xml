<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================
         PARENT — Spring Boot BOM (Bill of Materials)
         Manages all dependency versions automatically.
         You should NOT specify versions on Spring-managed deps
         below; the parent POM already pins compatible versions.
    ========================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- Fetch from Maven Central, not local -->
    </parent>

    <!-- =========================================================
         PROJECT COORDINATES
    ========================================================= -->
    <groupId>com.clickkart</groupId>
    <artifactId>clickkart-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ClickKart Backend</name>
    <description>
        ClickKart e-commerce REST API.
        Built with Spring Boot 3, Spring Security 6 + JWT,
        Spring Data JPA, and MySQL 8.
    </description>

    <!-- =========================================================
         GLOBAL PROPERTIES
    ========================================================= -->
    <properties>
        <!-- Java version — must match your local JDK -->
        <java.version>21</java.version>

        <!-- jjwt version — managed here so it is consistent
             across the three jjwt artifacts below -->
        <jjwt.version>0.12.6</jjwt.version>

        <!-- Encoding — prevents "unmappable character" warnings -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- =========================================================
         DEPENDENCIES
         Grouped by function. Each group is explained inline.
    ========================================================= -->
    <dependencies>

        <!-- =======================================================
             GROUP 1 — WEB LAYER
             spring-boot-starter-web bundles:
               • Embedded Tomcat (no WAR deployment needed)
               • Spring MVC (REST controllers, request mapping)
               • Jackson (JSON serialisation / deserialisation)
               • Jakarta Servlet API
        ======================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- =======================================================
             GROUP 2 — PERSISTENCE LAYER
             spring-boot-starter-data-jpa bundles:
               • Spring Data JPA (repositories, JPQL)
               • Hibernate 6 (JPA implementation / ORM)
               • Spring ORM integration
               • HikariCP connection pool (fastest JDBC pool)
        ======================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL JDBC driver (runtime — not needed at compile time) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- =======================================================
             GROUP 3 — SECURITY LAYER
             spring-boot-starter-security bundles:
               • Spring Security 6 (filter chain, authentication manager)
               • BCryptPasswordEncoder
               • Method-level security (@PreAuthorize, @Secured)
               • CSRF protection (disabled for stateless JWT API)
        ======================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- =======================================================
             GROUP 4 — JWT (io.jsonwebtoken / jjwt 0.12.x)
             Three artifacts are required together:
               • jjwt-api    — Public API (interfaces, builder pattern)
               • jjwt-impl   — Runtime implementation (runtime scope)
               • jjwt-jackson — Jackson integration for JSON claims
             Version 0.12.x is the modern API (replaces legacy 0.9.x).
             Key classes:  Jwts, SecretKey, SignatureAlgorithm, Claims
        ======================================================= -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- =======================================================
             GROUP 5 — VALIDATION
             spring-boot-starter-validation bundles:
               • Jakarta Bean Validation 3.0 (JSR-380)
               • Hibernate Validator (reference implementation)
             Used with @Valid on @RequestBody DTOs.
             Annotations: @NotBlank, @Email, @Size, @Min, @Max,
                          @Pattern, @NotNull, @Positive
        ======================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- =======================================================
             GROUP 6 — LOMBOK
             Compile-time annotation processor that generates boilerplate:
               @Getter / @Setter       — eliminates accessor methods
               @NoArgsConstructor      — default constructor
               @AllArgsConstructor     — all-fields constructor
               @Builder                — builder pattern
               @Data                   — @Getter + @Setter + @ToString + @EqualsAndHashCode
               @Slf4j                  — injects a Logger field (log.info(), log.error())
             Lombok is a provided/optional scope at runtime.
        ======================================================= -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- =======================================================
             GROUP 7 — ACTUATOR (Health &amp; Monitoring)
             Exposes management endpoints:
               GET /actuator/health   — DB connectivity, disk space
               GET /actuator/info     — app version, git commit
             Secured in SecurityConfig — public in dev, ADMIN in prod.
        ======================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- =======================================================
             GROUP 8 — TESTING
             spring-boot-starter-test bundles:
               • JUnit 5 (Jupiter)
               • Mockito
               • AssertJ
               • MockMvc (for controller integration tests)
               • @SpringBootTest, @DataJpaTest, @WebMvcTest
        ======================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test — provides SecurityMockMvcRequestPostProcessors
             for testing secured endpoints with mock users/roles -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =========================================================
         BUILD PLUGINS
    ========================================================= -->
    <build>
        <plugins>

            <!-- Spring Boot Maven Plugin
                 mvn spring-boot:run   → start the dev server
                 mvn package           → build executable fat JAR
                 The excludes block strips Lombok from the packaged JAR
                 (Lombok is only needed at compile time) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin
                 Explicit Java 21 source/target.
                 annotationProcessorPaths ensures Lombok runs
                 before the main Java compilation phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
