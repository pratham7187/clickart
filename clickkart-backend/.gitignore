# =============================================================================
#  .gitignore — ClickKart Spring Boot Backend
# =============================================================================

# ---- Maven build output ----
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---- IntelliJ IDEA ----
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# ---- Eclipse ----
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ---- VS Code ----
.vscode/

# ---- Spring Boot application properties with secrets ----
# DO NOT commit files with real DB passwords or JWT secrets
application-prod.properties
application-local.properties
.env
*.env

# ---- Logs ----
*.log
logs/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Package / JAR files ----
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ---- Java compiled files ----
*.class
